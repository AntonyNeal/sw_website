# Partner-specific example environment file
NODE_ENV=development
PORT=3001

# API
VITE_API_BASE_URL=https://partner-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://partner-domain.com

# DATABASE
DATABASE_URL=postgresql://username:password@host:5432/database

# EMAIL
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=bookings@partner-domain.com
BUSINESS_NOTIFICATION_EMAIL=notifications@partner-domain.com
BUSINESS_NAME=Partner Business Name
BUSINESS_PHONE=+61 (2) 0000 0000
BUSINESS_ADDRESS=Partner Address

# SIMPLYBOOK.ME
SIMPLYBOOK_COMPANY=miss-dylan
SIMPLYBOOK_API_KEY=your_api_key_here
SIMPLYBOOK_SECRET_KEY=your_secret_key_here
SIMPLYBOOK_JSON_RPC_URL=https://user-api.simplybook.net/
SIMPLYBOOK_REST_API_URL=https://user-api-v2.simplybook.net/
SIMPLYBOOK_WEBHOOK_URL=https://api.partner-domain.com/api/v1/webhooks/simplybook
